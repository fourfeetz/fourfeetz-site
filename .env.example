# Never commit real credentials. Configure each Vercel environment separately.
DATABASE_URL=
STORE_SANDBOX_ENABLED=false
STORE_PRODUCTION_SANDBOX_REVIEW_ENABLED=false
STORE_LIVE_PAYMENTS_ENABLED=false
TOSS_PAYMENTS_MODE=
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
STORE_PAYPAL_SANDBOX_ENABLED=false
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
STORE_PAYPAL_LIVE_ENABLED=false
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
ENABLE_FREE_PROMPT_PREVIEW=false # local development only; Vercel Preview is enabled automatically

# Infolinks stays disabled unless this flag is exactly "true". These IDs are public browser configuration, not secrets.
NEXT_PUBLIC_INFOLINKS_ENABLED=false
NEXT_PUBLIC_INFOLINKS_PID=3449690
NEXT_PUBLIC_INFOLINKS_WSID=0

# Paid files fail closed until every value is configured.
STORE_PAID_DOWNLOADS_ENABLED=false
BLOB_STORE_ID=
# Dedicated public editorial-image Blob connection. Keep it separate from paid/private assets.
BLOG_BLOB_READ_WRITE_TOKEN=
BLOG_BLOB_STORE_ID=
STORE_PAID_PDF_KO_BLOB_PATH=
STORE_PAID_PDF_EN_BLOB_PATH=
STORE_CREATOR_PDF_KO_BLOB_PATH=
STORE_CREATOR_PDF_EN_BLOB_PATH=

# Insights CMS (server-only values must never use NEXT_PUBLIC_)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ADMIN_EMAILS=admin@example.com
DATABASE_URL_UNPOOLED=
COMMENT_TOKEN_PEPPER=
# Preview/local: mock + NEXT_PUBLIC_COMMENTS_BOT_MODE=mock. Production: turnstile.
COMMENTS_BOT_MODE=mock
NEXT_PUBLIC_COMMENTS_BOT_MODE=mock
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# disabled | mock | resend. Keep Preview on mock.
COMMENT_EMAIL_MODE=mock
COMMENT_NOTIFICATION_TO=
COMMENT_NOTIFICATION_FROM=
RESEND_API_KEY=
